[Unit]
Description=MambaPose hardware-friendly optimization campaign
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=infinity
StartLimitBurst=4

[Service]
Type=exec
WorkingDirectory=/home/vicchen/workspace/MambaPose
Environment=PYTHONNOUSERSITE=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
ExecStart=/home/vicchen/workspace/MambaPose/.venv/bin/python /home/vicchen/workspace/MambaPose/tools/optimization/run_campaign.py --run
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30s
RestartSteps=2
RestartMaxDelaySec=2min
KillMode=control-group
TimeoutStopSec=5min
UMask=0027

[Install]
WantedBy=default.target
